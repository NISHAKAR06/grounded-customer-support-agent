# Grounded Customer Support Agent - Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control.

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# LLM Providers Configuration
# Supported options: 'mock', 'ollama', 'openai', 'groq', 'gemini', 'claude'
LLM_PROVIDER=mock

# Mock Provider (Offline deterministic simulation, no API key required)
MOCK_MODEL_NAME=mock-grounded-v1

# Ollama Provider (Local self-hosted LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# OpenAI Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq Provider (Ultra-fast cloud inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# Google Gemini Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Anthropic Claude Provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_NAME=claude-3-5-haiku-20241022

# Intent Classifier Configuration
INTENT_MODEL_PATH=models/intent_classifier
INTENT_CONFIDENCE_THRESHOLD=0.85

# Retrieval & Vector Store Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=models/embedding_model/faiss.index
RETRIEVAL_TOP_K=3
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Escalation Policy Thresholds
ESCALATION_MIN_CONFIDENCE=0.80
ESCALATION_MIN_RETRIEVAL_SCORE=0.60
